# Kamatera / production — copy to the server as backend/.env
#   cp .env.production.example .env
#   chmod 600 .env
#   nano .env   (set secrets; never commit .env)
#
# Do not copy your laptop backend/.env — use new DJANGO_SECRET_KEY and production values.

DJANGO_SECRET_KEY="change-me-generate-with-python-secrets-token_urlsafe"
DJANGO_DEBUG=False
# Public IP + domain when DNS is ready (comma-separated, no spaces)
DJANGO_ALLOWED_HOSTS=203.0.113.50,defensys.yourdomain.edu
# CSRF trusted origins (comma-separated, no spaces). Required for Django admin and API requests.
DJANGO_CSRF_TRUSTED_ORIGINS=https://defensys.yourdomain.edu

POSTGRES_DB=defensys_db
POSTGRES_USER=defensys
POSTGRES_PASSWORD="change-me-match-server-postgres-user"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_TEST_USE_POSTGRES=False

# WebSocket channel layer (Django Channels). Production: Redis on the VPS.
REDIS_URL=redis://127.0.0.1:6379/0

# Max sizes for file/data uploads (in bytes). Defaults: 500MB total request, 50MB kept in memory
# DATA_UPLOAD_MAX_MEMORY_SIZE=524288000
# FILE_UPLOAD_MAX_MEMORY_SIZE=52428800

# Email Backend (Gmail SMTP). Generate an App Password:
# Google Account → Security → 2-Step Verification → App Passwords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL="DefenSYS <your-email@gmail.com>"

# Base URL used in email links (password reset, notifications).
FRONTEND_URL=https://defensys.yourdomain.edu

# Error tracking & APM (Sentry)
# SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1

